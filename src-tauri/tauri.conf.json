{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "印刷工单",
  "version": "0.1.2",
  "identifier": "com.guanxc.factory-printing",
  "build": {
    "frontendDist": "../src/renderer/dist",
    "beforeDevCommand": "npm run dev --prefix ./src/renderer",
    "beforeBuildCommand": "npm run build --prefix ./src/renderer",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "印刷工单",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "maximized": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true,
    "trayIcon": null
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}